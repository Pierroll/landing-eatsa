# Variables de entorno — EATSA SAC
# Copia este archivo a `.env` y completa los valores reales.

# Resend (proveedor de email transaccional)
# Obtén tu API key en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Dominio verificado en Resend (ej. "EATSA <contacto@amazonicatropical.com>")
RESEND_FROM=onboarding@resend.dev
# Buzón que recibirá las solicitudes B2B
RESEND_TO=comercial@amazonicatropical.com

# URL pública del sitio (usada por sitemap, SEO, OG)
PUBLIC_SITE_URL=https://amazonicatropical.com
