---
import type { Locale, TranslationKey } from '@types';
import { useTranslations } from '@i18n/ui';
import { contactForm, siteConfig } from '@data/site';
import Container from '@components/ui/Container.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '@components/ui/Button.astro';
import { Phone, Mail, Clock } from 'lucide-astro';

/**
 * Formulario B2B de contacto.
 * POSTea a /api/contact (API route server-side con Resend).
 */
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

const countryLabels: Record<string, { es: string; en: string }> = {
  PE: { es: 'Perú', en: 'Peru' },
  US: { es: 'Estados Unidos', en: 'United States' },
  CA: { es: 'Canadá', en: 'Canada' },
  GB: { es: 'Reino Unido', en: 'United Kingdom' },
  DE: { es: 'Alemania', en: 'Germany' },
  FR: { es: 'Francia', en: 'France' },
  IT: { es: 'Italia', en: 'Italy' },
  ES: { es: 'España', en: 'Spain' },
  MY: { es: 'Malasia', en: 'Malaysia' },
  JP: { es: 'Japón', en: 'Japan' },
  NL: { es: 'Países Bajos', en: 'Netherlands' },
  AU: { es: 'Australia', en: 'Australia' },
  OTHER: { es: 'Otro', en: 'Other' },
};

const volumeLabels: Record<string, TranslationKey> = {
  '1-5': 'contact.form.volume',
  '5-20': 'contact.form.volume',
  '20-50': 'contact.form.volume',
  '50+': 'contact.form.volume',
};

const productLabels: Record<string, TranslationKey> = {
  cacao: 'products.cacao.name',
  cafe: 'products.cafe.name',
  jengibre: 'products.jengibre.name',
  frutas: 'products.frutas.name',
};
---

<section id="contacto" class="section-cream py-16 lg:py-24">
  <Container>
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Columna izquierda: header + info de confianza -->
      <div class="flex flex-col justify-between h-full fade-in-up stagger-children lg:pr-8 py-4">
        <div>
          <SectionHeader
            title={t('contact.title' as any)}
            subtitle={t('contact.subtitle' as any)}
            align="left"
          />
        </div>

        <div class="flex flex-col gap-5 sm:gap-8 my-8">
          {siteConfig.phones.map((phone) => (
            <a href={`tel:${phone.number.replace(/[^0-9+]/g, '')}`} class="group flex items-center gap-4 transition-all duration-200 active:scale-[0.98]">
              <div class="p-3 bg-white border border-gris-claro text-verde rounded-full shadow-sm transition-transform duration-200 group-hover:scale-110 group-hover:border-verde">
                <Phone class="w-5 h-5" />
              </div>
              <div class="flex flex-col">
                <p class="font-medium text-ebano text-lg">{phone.number}</p>
                <p class="text-sm text-gris-medio">{t(phone.roleKey as any)}</p>
              </div>
            </a>
          ))}
          <a href="mailto:comercial@amazonicatropical.com" class="group flex items-center gap-4 transition-all duration-200 active:scale-[0.98]">
            <div class="p-3 bg-white border border-gris-claro text-cacao rounded-full shadow-sm transition-transform duration-200 group-hover:scale-110 group-hover:border-cacao">
              <Mail class="w-5 h-5" />
            </div>
            <div>
              <p class="font-medium text-ebano text-lg">{t('contact.trust.email' as any)}</p>
            </div>
          </a>
          <div class="flex items-center gap-4">
            <div class="p-3 bg-white border border-gris-claro text-ebano/70 rounded-full shadow-sm">
              <Clock class="w-5 h-5" />
            </div>
            <div>
              <p class="font-medium text-ebano text-lg">{t('contact.trust.hours' as any)}</p>
            </div>
          </div>
        </div>

        <div class="card p-6 bg-white/60 border border-verde/10 shadow-sm relative overflow-hidden group">
          <div class="absolute top-0 left-0 w-1 h-full bg-verde transition-all duration-300"></div>
          <h3 class="font-semibold text-lg text-verde mb-2 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {t('contact.trust.box.title' as any)}
          </h3>
          <p class="text-ebano/75 text-sm leading-relaxed mb-6">{t('contact.trust.box.desc' as any)}</p>

          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 bg-verde/5 text-verde px-3 py-1.5 rounded-md text-xs font-medium border border-verde/10">
              <span class="w-1.5 h-1.5 rounded-full bg-verde"></span> {t('contact.trust.badge1' as any)}
            </span>
            <span class="inline-flex items-center gap-1.5 bg-cacao/5 text-cacao px-3 py-1.5 rounded-md text-xs font-medium border border-cacao/10">
              <span class="w-1.5 h-1.5 rounded-full bg-cacao"></span> {t('contact.trust.badge2' as any)}
            </span>
            <span class="inline-flex items-center gap-1.5 bg-ebano/5 text-ebano px-3 py-1.5 rounded-md text-xs font-medium border border-ebano/10">
              <span class="w-1.5 h-1.5 rounded-full bg-ebano"></span> {t('contact.trust.badge3' as any)}
            </span>
          </div>
        </div>
      </div>

      <!-- Columna derecha: formulario -->
      <div class="card shadow-elevated flex flex-col justify-between overflow-hidden p-0 relative">
        <!-- Top decorative banner (2 líneas gruesas, centro-izquierda) -->
        <div class="h-24 w-full bg-verde relative overflow-hidden flex items-center justify-start pl-[25%] sm:pl-[35%]">
          <div class="h-[150%] w-10 bg-white/30 -skew-x-[35deg] mr-6"></div>
          <div class="h-[150%] w-10 bg-white/30 -skew-x-[35deg]"></div>
        </div>
        
        <div class="p-8 sm:p-10 flex-1 flex flex-col justify-center">
          <form id="contact-form" action="/api/contact" method="POST" class="flex flex-col gap-4" novalidate>
          <input
            type="text"
            name="bot_trap_field"
            class="absolute -left-[9999px] opacity-0 pointer-events-none"
            tabindex="-1"
            aria-hidden="true"
            autocomplete="off"
          />

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="full_name" class="mb-1 block text-sm font-medium text-ebano">
                {t('contact.form.name' as any)} *
              </label>
              <input id="full_name" name="full_name" type="text" required class="form-field" />
            </div>
            <div>
              <label for="company" class="mb-1 block text-sm font-medium text-ebano">
                {t('contact.form.company' as any)} *
              </label>
              <input id="company" name="company" type="text" required class="form-field" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="email" class="mb-1 block text-sm font-medium text-ebano">
                {t('contact.form.email' as any)} *
              </label>
              <input id="email" name="email" type="email" required class="form-field" />
            </div>
            <div>
              <label for="phone" class="mb-1 block text-sm font-medium text-ebano">
                {t('contact.form.phone' as any)}
              </label>
              <input id="phone" name="phone" type="tel" class="form-field" />
            </div>
          </div>



          <div>
            <label for="message" class="mb-1 block text-sm font-medium text-ebano">
              {t('contact.form.message' as any)} *
            </label>
            <textarea id="message" name="message" rows="3" required class="form-field resize-none"></textarea>
          </div>

          <label class="flex cursor-pointer items-start gap-3 text-sm text-ebano/70">
            <input type="checkbox" name="terms" required checked class="mt-0.5 accent-verde h-4 w-4 rounded border-gris-claro text-verde focus:ring-verde" />
            <span class="leading-snug">{t('contact.form.terms' as any)}</span>
          </label>

          <div id="form-feedback" class="hidden rounded-btn p-3 text-sm" role="alert"></div>

          <div class="mt-2 flex flex-col gap-3">
            <Button type="submit" variant="primary" class="w-full">
              {t('contact.form.submit' as any)}
            </Button>
            <p class="text-center text-xs font-medium text-ebano/50">{t('contact.form.disclaimer' as any)}</p>
          </div>
        </form>
        </div>
        
        <!-- Bottom decorative banner (2 líneas gruesas, centro-derecha) -->
        <div class="h-24 w-full bg-verde relative overflow-hidden flex items-center justify-end pr-[25%] sm:pr-[35%]">
          <div class="h-[150%] w-10 bg-white/30 -skew-x-[35deg] mr-6"></div>
          <div class="h-[150%] w-10 bg-white/30 -skew-x-[35deg]"></div>
        </div>
      </div>
    </div>
  </Container>
</section>

<!-- Success Modal -->
<div id="success-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
  <div class="absolute inset-0 bg-ebano/20 backdrop-blur-sm"></div>
  <div id="success-modal-content" class="relative bg-white rounded-xl shadow-elevated p-8 max-w-sm w-full flex flex-col items-center text-center transform scale-95 transition-transform duration-300">
    <div class="w-16 h-16 bg-verde/10 rounded-full flex items-center justify-center text-verde mb-4">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h4 class="text-xl font-bold text-ebano mb-2">¡Enviado con éxito!</h4>
    <p id="modal-message" class="text-sm text-ebano/70 font-medium">Te contactaremos a la brevedad.</p>
  </div>
</div>



<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement;

  if (form && feedback) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault(); // Siempre evitar el reload nativo
      
      // 1. Validar formulario en el cliente
      if (!form.checkValidity()) {
        feedback.textContent = 'Por favor, rellena los campos obligatorios del formulario primero.';
        feedback.className = 'block rounded-btn p-3 text-sm font-medium bg-error/10 text-error border border-error/20 animate-fade-in-down';
        
        const firstInvalid = form.querySelector(':invalid') as HTMLElement;
        if (firstInvalid) firstInvalid.focus();
        return;
      }

      // 2. Preparar el envío (estado de carga)
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalBtnText = submitBtn.innerText;
      submitBtn.disabled = true;
      submitBtn.innerText = 'Enviando...';
      feedback.className = 'hidden';

      try {
        // 3. Enviar datos por fetch
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: form.method,
          body: formData,
        });

        const result = await response.json();

        if (response.ok && result.success) {
          // Éxito: Mostrar Modal Centrado
          const modal = document.getElementById('success-modal');
          const modalContent = document.getElementById('success-modal-content');
          const modalMsg = document.getElementById('modal-message');
          
          if (modal && modalContent && modalMsg) {
            modalMsg.textContent = result.message || 'Te contactaremos pronto.';
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modalContent.classList.remove('scale-95');
            modalContent.classList.add('scale-100');
            
            // Ocultar automáticamente a los 2.5 segundos
            setTimeout(() => {
              modal.classList.add('opacity-0', 'pointer-events-none');
              modalContent.classList.remove('scale-100');
              modalContent.classList.add('scale-95');
            }, 2500);
          }
          form.reset();
        } else {
          // Error del servidor (ej. validación o Resend falló)
          feedback.textContent = result.message || 'Hubo un error al enviar el mensaje. Inténtalo de nuevo.';
          feedback.className = 'block rounded-btn p-3 text-sm font-medium bg-error/10 text-error border border-error/20 animate-fade-in-down';
        }
      } catch (err) {
        // Error de red
        feedback.textContent = 'Error de conexión. Revisa tu internet e inténtalo de nuevo.';
        feedback.className = 'block rounded-btn p-3 text-sm font-medium bg-error/10 text-error border border-error/20 animate-fade-in-down';
      } finally {
        // Restaurar botón
        submitBtn.disabled = false;
        submitBtn.innerText = originalBtnText;
      }
    });

    // Quitar error visual al escribir de nuevo
    form.addEventListener('input', () => {
      if (form.checkValidity() && feedback.classList.contains('bg-error/10')) {
        feedback.className = 'hidden';
      }
    });
  }
</script>
