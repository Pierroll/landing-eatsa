---
import type { Locale } from '@types';
import { useTranslations } from '@i18n/ui';
import { getCollection } from 'astro:content';
import Container from '@components/ui/Container.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import { ShieldCheck, Award, Leaf, Globe, Truck } from 'lucide-astro';

/**
 * Certificaciones: ÚNICA sección con fondo Azul Apagado (regla del design system).
 * Texto blanco. Iconos en línea blanca sin relleno.
 * Respeta el flag enabled de cada certificación.
 */
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

const allCerts = await getCollection('certifications');
const activeCerts = allCerts.filter((c) => c.data.enabled);

const IconMap: Record<string, any> = {
  ShieldCheck,
  Award,
  Leaf,
  Globe,
  Truck
};
---

<section id="certificaciones" class="section-azul py-24 sm:py-32 overflow-hidden">
  <Container>
    <SectionHeader
      title={t('certifications.title' as any)}
      subtitle={t('certifications.subtitle' as any)}
      align="center"
      class="mb-16 text-crema [&_h2]:text-white [&_p]:text-white/75"
    />

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3 lg:grid-cols-5 stagger-children">
      {activeCerts.map((cert) => {
        const IconComponent = IconMap[cert.data.icon] || ShieldCheck;
        
        return (
          <div class="certification-card fade-in-up group flex flex-col items-center justify-center rounded-xl bg-white/10 p-8 text-center transition-all duration-300 hover:bg-white/20">
            <div class="mb-4 rounded-full bg-white/20 p-4 group-hover:bg-verde group-hover:scale-110 transition-all duration-300">
              <IconComponent class="h-8 w-8 text-white" />
            </div>
            <h3 class="text-lg font-semibold text-white">{t(cert.data.nameKey as any)}</h3>
            <p class="mt-2 text-sm text-white/80">{t(cert.data.yearKey as any)}</p>
          </div>
        );
      })}
    </div>
  </Container>
</section>
