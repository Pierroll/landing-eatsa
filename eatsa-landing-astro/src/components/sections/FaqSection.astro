---
import type { Locale, TranslationKey } from '@types';
import { useTranslations } from '@i18n/ui';
import { getCollection } from 'astro:content';
import Container from '@components/ui/Container.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';

/**
 * FAQ: items estáticos (no acordeón interactivo) desde la collection.
 * Si se quiere acordeón, el JS se añade en scripts/main.ts.
 */
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

const faqs = await getCollection('faq');
---

<section class="section-cream py-24">
  <Container>
    <SectionHeader
      title={t('faq.title' as any)}
      subtitle={t('faq.subtitle' as any)}
      align="center"
      class="mb-16"
    />

    <div class="mx-auto flex max-w-3xl flex-col gap-6">
      {faqs.map((faq, i) => (
        <details class={` group card p-6 ${i === 0 ? 'open' : ''}`}>
          <summary class="flex cursor-pointer items-center justify-between gap-4 list-none">
            <h3 class="text-base font-semibold text-verde">{t(faq.data.questionKey as any)}</h3>
            <svg class="h-5 w-5 flex-shrink-0 text-gris-medio transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-sm text-ebano/75">{t(faq.data.answerKey as any)}</p>
        </details>
      ))}
    </div>
  </Container>
</section>
