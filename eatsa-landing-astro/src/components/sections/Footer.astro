---
import type { Locale, TranslationKey } from '@types';
import { useTranslations } from '@i18n/ui';
import { siteConfig, navItems } from '@data/site';
import Container from '@components/ui/Container.astro';

/**
 * Footer: 4 columnas (Empresa, Enlaces rápidos, Categorías, Legal y Contacto).
 * Datos desde siteConfig. Las labels de nav vía i18n.
 */
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

const year = new Date().getFullYear();
---

<footer class="bg-ebano py-16 text-crema/80">
  <Container>
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      {/* Columna 1: Empresa */}
      <div>
        <div class="mb-4 flex items-center gap-2">
          <img src={siteConfig.logo} alt={siteConfig.name} class="h-8 w-auto" width="32" height="32" />
          <span class="font-display text-lg font-semibold text-crema">EATSA SAC</span>
        </div>
        <p class="text-sm text-crema/60">{siteConfig.legalName}</p>
        <p class="mt-1 text-xs text-crema/40">RUC: {siteConfig.ruc}</p>
        <p class="mt-3 text-xs text-crema/50">{siteConfig.address}</p>
      </div>

      {/* Columna 2: Enlaces rápidos */}
      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-crema">
          {t('footer.quickLinks' as any)}
        </h4>
        <ul class="flex flex-col gap-2 text-sm">
          {navItems.map((item) => (
            <li>
              <a href={`/${lang}/#${item.id}`} class="text-crema/70 transition-colors hover:text-verde">
                {t(item.labelKey as any)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Columna 3: Categorías (productos) */}
      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-crema">
          {t('footer.categories' as any)}
        </h4>
        <ul class="flex flex-col gap-2 text-sm">
          <li><a href={`/${lang}/#productos`} class="text-crema/70 transition-colors hover:text-verde">{t('products.cacao.name' as any)}</a></li>
          <li><a href={`/${lang}/#productos`} class="text-crema/70 transition-colors hover:text-verde">{t('products.cafe.name' as any)}</a></li>
          <li><a href={`/${lang}/#productos`} class="text-crema/70 transition-colors hover:text-verde">{t('products.nibs.name' as any)}</a></li>
          <li><a href={`/${lang}/#productos`} class="text-crema/70 transition-colors hover:text-verde">{t('products.chocolate.name' as any)}</a></li>
        </ul>
      </div>

      {/* Columna 4: Legal y Contacto */}
      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-crema">
          {t('footer.legal' as any)}
        </h4>
        <ul class="flex flex-col gap-2 text-sm">
          {siteConfig.emails.map((email) => (
            <li>
              <a href={`mailto:${email.address}`} class="text-crema/70 transition-colors hover:text-verde">{email.address}</a>
            </li>
          ))}
          <li><a href={`/${lang}/#contacto`} class="text-crema/70 underline-offset-2 hover:text-verde hover:underline">{t('contact.form.submit' as any)}</a></li>
        </ul>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-crema/10 pt-8 text-xs text-crema/50 sm:flex-row">
      <p>© {year} {siteConfig.legalName}. {t('footer.rights' as any)}</p>
      <div class="flex gap-4">
        <a href={`/${lang}/`} class="transition-colors hover:text-crema">{t('footer.privacy' as any)}</a>
        <a href={`/${lang}/`} class="transition-colors hover:text-crema">{t('footer.terms' as any)}</a>
      </div>
    </div>
  </Container>
</footer>
