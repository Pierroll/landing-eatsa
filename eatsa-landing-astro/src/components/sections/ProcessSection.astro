---
import type { Locale, TranslationKey } from '@types';
import { useTranslations } from '@i18n/ui';
import { getCollection } from 'astro:content';
import Container from '@components/ui/Container.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Badge from '@components/ui/Badge.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Timeline vertical zigzag: cada paso alterna lado.
 * Foto + texto-card en lados opuestos, número de paso destacado.
 */
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

const steps = (await getCollection('process')).sort((a, b) => a.data.number - b.data.number);
import imgStep1 from '../../assets/process/paso-1-cosecha.jpeg';
import imgStep2 from '../../assets/process/paso-2-procesamiento.jpeg';
import imgStep3 from '../../assets/process/paso-3-calidad.png';
import imgStep4 from '../../assets/process/paso-4-exportacion.png';

const processImages: Record<string, ImageMetadata> = {
  '/assets/process/paso-1-cosecha.jpeg': imgStep1,
  '/assets/process/paso-2-procesamiento.jpeg': imgStep2,
  '/assets/process/paso-3-calidad.png': imgStep3,
  '/assets/process/paso-4-exportacion.png': imgStep4,
};
---

<section id="proceso" class="section-white py-16 lg:py-32">
  <Container>
    <SectionHeader
      title={t('process.title' as any)}
      subtitle={t('process.subtitle' as any)}
      align="left"
      class="mb-20"
    />

    <div class="relative flex flex-col gap-16 stagger-children">
      {steps.map(async (step) => {
        const isLeft = step.data.side === 'left';
        const photoKey = step.data.photo;
        const resolvedPhoto = processImages[photoKey];
        
        return (
          <div class={` relative flex flex-col items-center gap-8 lg:flex-row ${isLeft ? '' : 'lg:flex-row-reverse'} ${isLeft ? 'fade-in-right' : 'fade-in-left'}`}>
            {/* Foto del paso */}
            <div class="w-full lg:w-1/2">
              <div class="card overflow-hidden p-0">
                {resolvedPhoto && (
                  <Image
                    src={resolvedPhoto}
                    alt={t(step.data.titleKey as any)}
                    class="h-72 w-full object-cover blur-hover-img"
                    loading="lazy"
                    width={600}
                    height={288}
                  />
                )}
              </div>
            </div>

            {/* Texto del paso */}
            <div class="w-full lg:w-1/2 lg:px-8">
              <div class="flex items-start gap-5">
                <span class="flex h-12 w-12 sm:h-16 sm:w-16 shrink-0 items-center justify-center rounded-2xl bg-verde font-display text-xl sm:text-2xl font-bold text-crema shadow-lg shadow-verde/20">
                  {step.data.number}
                </span>
                <div>
                  <h3 class="text-2xl font-bold text-verde text-reveal-wrapper">
                    <span class="text-reveal">{t(step.data.titleKey as any)}</span>
                  </h3>
                  <p class="mt-3 text-base leading-relaxed text-ebano/75">{t(step.data.descKey as any)}</p>
                </div>
              </div>
              <div class="mt-6 flex flex-wrap gap-2">
                {step.data.tags.map((tag) => (
                  <Badge variant="attribute" label={t(tag as any)} />
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </Container>
</section>
