---
import type { Locale, TranslationKey } from '@types';
import { useTranslations } from '@i18n/ui';
import { siteConfig } from '@data/site';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import { Image } from 'astro:assets';
import frontisImg from '../../assets/company/frontis.jpg';

/**
 * Información de empresa: dirección, emails, teléfonos, horarios, redes.
 * Consumida desde siteConfig (datos estructurales, no traducibles aquí).
 */
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
---

<section class="section-white py-24">
  <Container>
    <div class="grid gap-12 lg:grid-cols-2">
      <!-- Datos de contacto -->
      <div class="">
        <h2 class="mb-6 text-3xl">{t('contact.info.title' as any)}</h2>
        <p class="mb-8 text-ebano/75">{t('contact.info.subtitle' as any)}</p>

        {/* Dirección */}
        <div class="mb-6 flex items-start gap-3">
          <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-verde" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <div>
            <p class="text-sm font-medium text-ebano">{t('contact.info.address' as any)}</p>
            <p class="text-sm text-ebano/70">{siteConfig.address}</p>
          </div>
        </div>

        {/* Emails */}
        <div class="mb-6 flex items-start gap-3">
          <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-verde" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <div class="flex flex-col gap-1">
            {siteConfig.emails.map((email) => (
              <a href={`mailto:${email.address}`} class="text-sm text-cacao underline-offset-2 hover:underline">
                {email.address} <span class="text-gris-medio">· {t(email.roleKey as any)}</span>
              </a>
            ))}
          </div>
        </div>

        {/* Teléfonos */}
        <div class="mb-6 flex items-start gap-3">
          <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-verde" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <div class="flex flex-col gap-1">
            {siteConfig.phones.map((phone) => (
              <a href={`tel:${phone.number.replace(/\s/g, '')}`} class="text-sm text-cacao underline-offset-2 hover:underline">
                {phone.number} <span class="text-gris-medio">· {t(phone.roleKey as any)}</span>
              </a>
            ))}
          </div>
        </div>

        {/* Horarios */}
        <div class="mb-8 flex items-start gap-3">
          <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-verde" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-sm text-ebano/70">{t(siteConfig.hoursKey as any)}</p>
        </div>

        {/* CTA: agendar reunión */}
        <Button href={siteConfig.calendlyUrl} variant="secondary">
          {t('contact.info.scheduleMeeting' as any)}
        </Button>
      </div>

      {/* Mapa / imagen del frontis */}
      <div class=" card overflow-hidden p-0">
        <Image
          src={frontisImg}
          alt={siteConfig.name}
          class="h-full min-h-[400px] w-full object-cover"
          loading="lazy"
          width={600}
          height={500}
        />
      </div>
    </div>
  </Container>
</section>
