---
import type { Locale, TranslationKey } from '@types';
import { useTranslations } from '@i18n/ui';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';

/**
 * CTA Final: fondo Verde Bosque sólido (autoridad de marca), texto crema.
 * 3 checks + botón cotización + enlace Calendly.
 */
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

const checks = [
  t('cta.check1' as any),
  t('cta.check2' as any),
  t('cta.check3' as any),
];
---

<section class="section-verde py-28 relative overflow-hidden">
  <!-- Elementos decorativos de fondo -->
  <div class="absolute top-0 right-0 h-64 w-64 translate-x-1/3 -translate-y-1/3 rounded-full bg-crema/5 blur-3xl" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 h-64 w-64 -translate-x-1/3 translate-y-1/3 rounded-full bg-dorado/5 blur-3xl" aria-hidden="true"></div>

  <Container class="relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-4 text-4xl font-bold text-crema sm:text-5xl lg:text-6xl">{t('cta.title' as any)}</h2>
      <p class="mb-10 text-lg text-crema/75 sm:text-xl">{t('cta.subtitle' as any)}</p>

      <!-- Checks con más espaciado y presencia -->
      <ul class="mb-12 flex flex-wrap justify-center gap-x-8 gap-y-3">
        {checks.map((check) => (
          <li class="flex items-center gap-3 text-base text-crema/90">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-dorado/20">
              <svg class="h-3.5 w-3.5 text-dorado" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            {check}
          </li>
        ))}
      </ul>

      <!-- CTAs con más peso -->
      <div class="flex flex-wrap items-center justify-center gap-6">
        <Button variant="primary" id="final-price-btn" class="bg-dorado text-white hover:bg-dorado/90 !px-10 !py-4 text-lg shadow-lg shadow-dorado/20">
          {t('cta.button' as any)}
        </Button>
        <a href="https://calendly.com/comercial-amazonicatropical/30min" target="_blank" rel="noopener" class="text-base text-crema/70 underline underline-offset-4 transition-colors hover:text-crema">
          {t('cta.meeting' as any)}
        </a>
      </div>
    </div>
  </Container>
</section>
