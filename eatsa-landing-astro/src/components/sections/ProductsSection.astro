---
import type { Locale } from '@types';
import { useTranslations } from '@i18n/ui';
import Container from '@components/ui/Container.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import ProductCard from '@components/ProductCard.astro';
import { getProductos } from '@/lib/db';

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

// Manejar error de carga de productos
let loadError = false;
let activeProducts: Awaited<ReturnType<typeof getProductos>> = [];
let uniqueTags: string[] = [];

try {
  const allProducts = await getProductos();
  // Mostrar solo productos activos
  activeProducts = allProducts.filter(p => p.status === 'activo');
  // Extraer tags únicos para filtros
  uniqueTags = [...new Set(activeProducts.map(p => p.tag))];
} catch (e) {
  loadError = true;
  console.error('[ProductsSection] Error loading products:', e);
}
---

<section id="productos" class="section-white py-24 sm:py-32">
  <Container>
    <div class="mb-12">
      <SectionHeader
        title={t('products.title' as any)}
        subtitle={t('products.subtitle' as any)}
        align="left"
      />
    </div>

    <!-- Toolbar: filtros + search + sort -->
    <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" data-products-toolbar>
      <!-- Filtros por tag (pills) -->
      <div class="flex flex-wrap gap-2" data-filter-pills>
        <button class="filter-pill active" data-filter="all">{t('products.filterAll' as any)}</button>
        {uniqueTags.map(tag => (
          <button class="filter-pill" data-filter={tag}>{tag}</button>
        ))}
      </div>

      <!-- Search + sort -->
      <div class="flex items-center gap-3">
        <input
          type="search"
          class="form-field w-48 sm:w-56"
          placeholder={t('products.searchPlaceholder' as any)}
          data-search-input
        />
        <select class="form-field w-auto" data-sort-select>
          <option value="default">{t('products.sortLabel' as any)}</option>
          <option value="name-asc">{t('products.sortAZ' as any)}</option>
          <option value="name-desc">{t('products.sortZA' as any)}</option>
        </select>
      </div>
    </div>

    <!-- Mensaje sin resultados (filtros) -->
    <p class="hidden text-center text-gris-medio py-16 col-span-full" data-no-results>
      No se encontraron productos con los filtros seleccionados.
    </p>

    <!-- Grid de productos -->
    {loadError ? (
      <!-- Error state -->
      <div class="flex flex-col items-center justify-center py-20 text-center">
        <div class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-full bg-error/10">
          <svg class="h-8 w-8 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-ebano">{t('products.errorTitle' as any)}</h3>
        <p class="mt-2 max-w-md text-gris-medio">{t('products.errorDescription' as any)}</p>
        <a href={`/${lang}/#productos`} class="mt-6 text-sm font-medium text-verde underline underline-offset-4 hover:text-verde-dark transition-colors">
          {t('products.retry' as any)}
        </a>
      </div>
    ) : activeProducts.length === 0 ? (
      <!-- Empty state -->
      <div class="flex flex-col items-center justify-center py-20 text-center">
        <div class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-full bg-cacao/10">
          <svg class="h-8 w-8 text-cacao" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-ebano">{t('products.emptyTitle' as any)}</h3>
        <p class="mt-2 max-w-md text-gris-medio">{t('products.emptyDescription' as any)}</p>
      </div>
    ) : (
      <div class="flex flex-wrap justify-center gap-8 max-w-6xl mx-auto stagger-children" data-products-grid>
        {activeProducts.map((product, index) => (
          <div class="product-card-wrapper w-full sm:w-[calc(50%-1rem)] lg:w-[340px]" style={`--i: ${index}`}>
            <ProductCard
              name={product.name}
              tag={product.tag}
              image={product.image}
              specs={product.specs || []}
              attributes={product.attributes || []}
              productId={product.id}
              seeSpecsKey={'products.seeSpecs' as any}
              lang={lang}
            />
          </div>
        ))}
      </div>
    )}
  </Container>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const grid = document.querySelector('[data-products-grid]');
    const noResults = document.querySelector('[data-no-results]');
    const pills = document.querySelectorAll('.filter-pill');
    const searchInput = document.querySelector('[data-search-input]') as HTMLInputElement;
    const sortSelect = document.querySelector('[data-sort-select]') as HTMLSelectElement;
    if (!grid || !searchInput || !noResults) return;

    // Guardar estado original de las cards (name y tag)
    const cards = Array.from(grid.querySelectorAll('.product-card-wrapper'));
    const cardData = cards.map(card => {
      const inner = card.querySelector('.card');
      const nameEl = inner?.querySelector('h3');
      return {
        el: card,
        name: nameEl?.textContent?.trim().toLowerCase() || '',
        tag: inner?.querySelector('.badge-tag')?.textContent?.trim() || '',
      };
    });

    const applyFilters = () => {
      const activeFilter = document.querySelector('.filter-pill.active')?.getAttribute('data-filter') || 'all';
      const query = searchInput.value.toLowerCase().trim();
      const sort = sortSelect?.value || 'default';

      let visible = cardData.filter(d => {
        const matchTag = activeFilter === 'all' || d.tag === activeFilter;
        const matchSearch = !query || d.name.includes(query);
        return matchTag && matchSearch;
      });

      // Sort
      if (sort === 'name-asc') visible.sort((a, b) => a.name.localeCompare(b.name));
      if (sort === 'name-desc') visible.sort((a, b) => b.name.localeCompare(a.name));

      // Mostrar/ocultar mensaje sin resultados
      if (visible.length === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }

      // Ocultar los que no coinciden
      cardData.forEach(d => {
        const isVisible = visible.includes(d);
        (d.el as HTMLElement).classList.toggle('hidden', !isVisible);
        (d.el as HTMLElement).style.opacity = isVisible ? '1' : '0';
      });

      // Reordenar manteniendo el orden del sort/filtro
      if (sort !== 'default') {
        const target = visible.map(d => d.el);
        target.forEach(el => grid.appendChild(el));
      }
    };

    // Pills de filtro
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        applyFilters();
      });
    });

    // Search con debounce
    let debounceTimer: ReturnType<typeof setTimeout>;
    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyFilters, 200);
    });

    // Sort
    sortSelect?.addEventListener('change', applyFilters);
  });
</script>
