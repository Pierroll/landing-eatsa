---
import type { TranslationKey } from '@i18n/ui';
import type { Locale } from '@types';

/**
 * Modal base reutilizable.
 * Se instancia 3 veces: precio, spec, feedback.
 * El JS en scripts/modal.ts maneja apertura/cierre.
 */
interface Props {
  id: string;
  titleKey: TranslationKey;
  lang: Locale;
  /** 'sm' | 'md' | 'lg' */
  size?: string;
}

const { id, titleKey, lang, size = 'md' } = Astro.props;

const { useTranslations } = await import('@i18n/ui');
const t = useTranslations(lang);

const sizeClass = size === 'lg' ? 'max-w-3xl' : size === 'sm' ? 'max-w-md' : 'max-w-lg';
---

<div
  id={id}
  class="fixed inset-0 z-[100] items-center justify-center bg-ebano/50 p-4"
  data-state="closed"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}-title`}
>
  <div class={`modal-content w-full ${sizeClass} rounded-xl bg-white p-8 shadow-elevated`} data-modal-body>
    <div class="flex items-center justify-between">
      <h3 id={`${id}-title`} class="text-xl text-verde">{t(titleKey)}</h3>
      <button
        class="modal-close-btn min-h-11 min-w-11 flex items-center justify-center rounded-btn text-gris-medio transition-colors hover:bg-crema hover:text-ebano"
        aria-label={t('modal.close' as TranslationKey)}
        data-modal-close={id}
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div id={`${id}-body`} class="mt-6">
      <slot />
    </div>
  </div>
</div>

<style>
  /* Modal backdrop */
  div[data-state] {
    transition: opacity 0.3s var(--ease-out-quint), backdrop-filter 0.3s var(--ease-out-quint);
    display: flex;
    backdrop-filter: blur(4px);
  }

  /* Modal body */
  div[data-state] [data-modal-body] {
    transition: transform 0.3s var(--ease-out-quint), opacity 0.3s var(--ease-out-quint);
  }

  /* Closed state */
  div[data-state="closed"] {
    opacity: 0;
    pointer-events: none;
  }
  div[data-state="closed"] [data-modal-body] {
    transform: scale(0.95) translateY(8px);
    opacity: 0.7;
  }

  /* Open state */
  div[data-state="open"] {
    opacity: 1;
    pointer-events: auto;
  }
  div[data-state="open"] [data-modal-body] {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    div[data-state] {
      transition: none !important;
    }
    div[data-state] [data-modal-body] {
      transition: none !important;
    }
  }
</style>
