---
import { cn } from '@lib/utils';
import type { CardProps } from '@types';

const {
  surface = 'white',
  padding = 'lg',
  class: className,
} = Astro.props as CardProps;

// El blanco rompe el crema intencionalmente (tarjetas, testimonios).
// surface="cream" es para tarjetas que viven sobre fondo blanco/azul.
const surfaceClass = surface === 'white' ? 'bg-white' : 'bg-crema';
const paddingClass = padding === 'lg' ? 'p-8' : 'p-6';
const classes = cn('card', surfaceClass, paddingClass, className);
---

<div class={classes}>
  <slot />
</div>
