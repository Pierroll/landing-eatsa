{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@components/*": ["src/components/*"],
            "@layouts/*": ["src/layouts/*"],
            "@scripts/*": ["src/scripts/*"],
            "@i18n/*": ["src/i18n/*"],
            "@lib/*": ["src/lib/*"],
            "@types": ["src/types/index.ts"],
            "@types/*": ["src/types/*"],
            "@data/*": ["src/data/*"],
            "@assets/*": ["src/assets/*"],
            "@store/*": ["src/store/*"]
        }
    }
}
